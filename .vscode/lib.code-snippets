	"MapUsersToGroups": {
		"scope": "nix",
		"prefix": "mapUsersToGroups",
		"body": [
			"users.users = snowfall.mapUsersToGroup {",
			"  groups = [ $1 ];",
			"  users = builtins.attrNames (config.home-manager.users or { });",
			"};"
		],
		"description": "Map multiple users to multiple groups using snowfall.mapUsersToGroup"
	}
}